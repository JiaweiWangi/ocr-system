# ── 依赖 ──
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── 构建产物 ──
.next/
out/
build/
dist/
coverage/

# Prisma 生成代码（prisma generate 产物，不入库）
src/generated/

# ── 运行时数据（用户上传图片 + SQLite，绝不入库）──
storage/
*.db
*.db-journal
*.db-shm
*.db-wal

# ── 环境变量（含百度 API 密钥；.env.example 作模板入库）──
.env
.env.*
!.env.example

# ── 日志 ──
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── TypeScript / Next ──
*.tsbuildinfo
next-env.d.ts

# ── 编辑器 / 系统 ──
.vscode/
.idea/
.DS_Store
Thumbs.db
*.pem

# ── 部署 ──
.vercel
